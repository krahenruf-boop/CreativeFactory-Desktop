# Never publish user data, development evidence, credentials, caches, or built apps.
/*
!/.gitignore
!/.gitattributes
!/README.md
!/AUTOCUT_VERSION
!/app_shell/
!/backend/
!/web/
!/vendor/
!/resources/
!/licenses/
!/distribution/
!/scripts/
!/tests/
!/docs/
!/manifests/
/docs/*
!/docs/COMPANY_MAC.md
!/docs/MIGRATION_AUDIT.md
!/docs/RELEASE_NOTES.md
/manifests/*
!/manifests/latest-build.json
!/manifests/engine-snapshot.json
!/manifests/runtime-lock.json
!/manifests/dependencies-main.json
!/manifests/production.json
!/manifests/resource-licenses.json
!/manifests/ssh-hosts.json
__pycache__/
*.pyc
.DS_Store
*.sqlite*
*.db
.env*
*.pem
*.key
*.app/
*.mp4
*.mov
*.webm
*.wav
*.mp3
# Legacy local diagnostic scripts remain on the development Mac, not in releases.
/scripts/*
!/scripts/build.py
!/scripts/build_icons.swift
!/scripts/compatibility.py
!/scripts/stage_engine.py
!/scripts/build_autocut_app.sh
!/scripts/*company*
!/scripts/verify_distribution.py
!/scripts/export_engine_snapshot.py
!/scripts/prepare_runtime_distribution.py
!/scripts/publish_release.py
